# =============================================================================
# OCR / PI Data Extraction - production configuration
#
#   Copy this file to `.env` in the same folder and edit it:
#       cp .env.example .env
# =============================================================================

# --- RUN MODE (the ONLY switch between CPU and GPU) --------------------------
#   cpu   - no GPU (slow: minutes per document)
#   gpu   - NVIDIA GPU (needs nvidia driver + nvidia-container-toolkit)
#   rocm  - AMD GPU / Radeon (Linux host with amdgpu driver)
COMPOSE_PROFILES=rocm

# App image tag built by `docker compose up --build`
VERSION=latest

# --- OLLAMA IMAGES -----------------------------------------------------------
# OLLAMA_IMAGE      is used by cpu and gpu (NVIDIA) modes - the standard Ollama
#                   image contains the CUDA runtime, so one image covers both.
# OLLAMA_IMAGE_ROCM is used only by rocm (AMD/Radeon) mode.
# For OFFLINE servers point these at the bundled images from
# scripts\docker-image-exporter.ps1 (model baked in):
#   ocr-ollama-bundled:<version>       / ocr-ollama-bundled-rocm:<version>
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_IMAGE_ROCM=ollama/ollama:rocm

# Ports
OCR_APP_PORT=8080

# Vision model (pulled by ollama-init on first start if not already present)
OLLAMA_MODEL=qwen2.5vl:3b

# --- GPU sizing guide --------------------------------------------------------
# >= 6 GB VRAM : defaults below are fine (full offload).
# 4 GB VRAM    : OLLAMA_NUM_CTX=4096, OCR_MAX_IMAGE_DIMENSION=1280
# 2-3 GB VRAM  : OLLAMA_NUM_CTX=4096, OCR_MAX_IMAGE_DIMENSION=1024
#                (model partially offloads to CPU - still 2-5x faster than CPU)
# -----------------------------------------------------------------------------

# Ollama behaviour
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_CTX=8192
# Flash attention + q8 KV cache ~halve KV memory (important on 2-4 GB cards)
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# AMD only: override for unsupported Radeon models (e.g. 10.3.0 for RX 6000)
HSA_OVERRIDE_GFX_VERSION=

# App timeouts (on GPU you can lower OLLAMA_IDLE_TIMEOUT to 2m)
OLLAMA_IDLE_TIMEOUT=10m
OLLAMA_REQUEST_TIMEOUT=30m

# NVIDIA GPU count for gpu mode (all, or a number like 1)
GPU_COUNT=all

# Image preprocessing (lower dimension = fewer vision tokens = faster + less VRAM)
OCR_RENDER_DPI=200
OCR_MAX_IMAGE_DIMENSION=1536

# Upload limit
MAX_FILE_SIZE=50MB

# Callback OAuth (client-credentials) - REQUIRED for callback delivery.
# NOTE: callback DESTINATIONS are per-job (each API request carries its own
# callbackUrl); only the token endpoint is configured here.
CALLBACK_AUTH_TOKEN_URL=
CALLBACK_AUTH_CLIENT_ID=
CALLBACK_AUTH_CLIENT_SECRET=
CALLBACK_AUTH_SCOPE=

# JVM
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# =============================================================================
# v2: Spring AI RAG extraction (/api/v2/pi-extraction)
#
# Leave everything below at its defaults for a purely local setup: Ollama does
# both the vision and the embeddings, nothing leaves the host.
#
# To run v1 ONLY, without PostgreSQL, set:  SPRING_PROFILES_ACTIVE=lite
# =============================================================================
SPRING_PROFILES_ACTIVE=

# --- Database (knowledge base + vector index + audit trail + cache) ----------
POSTGRES_IMAGE=pgvector/pgvector:pg17
POSTGRES_DB=ocr
POSTGRES_USER=ocr
# CHANGE THIS before any deployment that is not your laptop.
POSTGRES_PASSWORD=ocr

# --- Knowledge base ----------------------------------------------------------
AI_RAG_ENABLED=true
# Default provider for extraction when a request does not name one.
AI_DEFAULT_PROVIDER=ollama
# Embedding model, pulled by ollama-init. Independent of the chat provider on
# purpose. CHANGING THIS REQUIRES: a new Flyway migration if the dimension
# differs, then POST /api/v2/knowledge/reindex.
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=768

# --- Optional cloud providers ------------------------------------------------
# Set <NAME>_ENABLED=true and supply the key. Ollama stays the default either
# way; a request selects a provider with ?provider=<name>.
AI_OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

AI_ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

AI_AZURE_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Vertex uses Application Default Credentials; mount the key file and point
# GOOGLE_APPLICATION_CREDENTIALS at it inside the container.
AI_VERTEX_ENABLED=false
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-pro
GOOGLE_APPLICATION_CREDENTIALS=

# Bedrock uses the default AWS credential chain.
AI_BEDROCK_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL=

# OpenAI-compatible endpoints (no extra dependency, configuration only)
AI_GROQ_ENABLED=false
GROQ_API_KEY=
AI_DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
AI_MISTRAL_ENABLED=false
MISTRAL_API_KEY=
