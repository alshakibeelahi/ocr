# =============================================================================
# OCR / PI Data Extraction - production configuration
#
#   Copy this file to `.env` in the same folder and edit it:
#       cp .env.example .env
# =============================================================================

# --- RUN MODE (the ONLY switch between CPU and GPU) --------------------------
#   cpu   - no GPU (slow: minutes per document)
#   gpu   - NVIDIA GPU (needs nvidia driver + nvidia-container-toolkit)
#   rocm  - AMD GPU / Radeon (Linux host with amdgpu driver)
# `cpu` is the only mode that starts on any machine; gpu/rocm fail outright when
# the host has no matching runtime, so set those per-server.
COMPOSE_PROFILES=cpu

# App image tag built by `docker compose up --build`
VERSION=latest

# --- OLLAMA IMAGES -----------------------------------------------------------
# OLLAMA_IMAGE      is used by cpu and gpu (NVIDIA) modes - the standard Ollama
#                   image contains the CUDA runtime, so one image covers both.
# OLLAMA_IMAGE_ROCM is used only by rocm (AMD/Radeon) mode.
# For OFFLINE servers point these at the bundled images from
# scripts\docker-image-exporter.ps1 (model baked in):
#   ocr-ollama-bundled:<version>       / ocr-ollama-bundled-rocm:<version>
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_IMAGE_ROCM=ollama/ollama:rocm

# Ports
OCR_APP_PORT=8080

# --- VISION MODEL (pulled by ollama-init on first start if not present) ------
# Changing this one line is the whole model switch - nothing in the app is
# model-specific. Size ladder: 3b -> 7b -> 32b -> 72b (there is no 5b).
#
#   qwen2.5vl:3b   ~3.2 GB resident   fastest, least reliable on dense tables
#   qwen2.5vl:7b   ~6.0 GB resident   ~2x slower than 3b, clearly better extraction
#   qwen2.5vl:32b  ~21 GB resident    GPU only
#
# 3b is the default because 7b does not finish inside the caller's timeout on a
# CPU-only host. On a GPU, move up to 7b.
OLLAMA_MODEL=qwen2.5vl:3b

# --- GPU sizing guide --------------------------------------------------------
# >= 6 GB VRAM : defaults below are fine (full offload).
# 4 GB VRAM    : OLLAMA_NUM_CTX=4096, OCR_MAX_IMAGE_DIMENSION=1280
# 2-3 GB VRAM  : OLLAMA_NUM_CTX=4096, OCR_MAX_IMAGE_DIMENSION=1024
#                (model partially offloads to CPU - still 2-5x faster than CPU)
# -----------------------------------------------------------------------------

# --- CPU-ONLY sizing guide (COMPOSE_PROFILES=cpu) ----------------------------
# The values below the guides are GPU-oriented. On a CPU-only host the render
# settings are what decide whether a job finishes at all, because every extra
# pixel is vision tokens the CPU has to decode serially. For a 4-core / 16 GB
# desktop running qwen2.5vl:3b, override:
#
#   OLLAMA_NUM_THREAD=4            # = PHYSICAL cores; more than that is slower
#   OCR_RENDER_DPI=150
#   OCR_MAX_IMAGE_DIMENSION=1024
#   OCR_MAX_PAGES=2
#   JAVA_OPTS=-Xmx1g               # MaxRAMPercentage=75 would hand the JVM
#                                  # ~12 GB and leave nothing for the model
#
# Moving up to 7b on such a host also needs OLLAMA_IDLE_TIMEOUT=15m and
# OLLAMA_REQUEST_TIMEOUT=45m, or jobs are cut off mid-extraction.
#
# On Docker Desktop / WSL2 the model lives inside the WSL2 VM, which defaults to
# roughly half of host RAM. Measured on a 16 GB box: 7b sits at 5.7 GB resident
# against a ~8 GB VM cap, so it fits with almost no margin. Raise the cap in
# %USERPROFILE%\.wslconfig ([wsl2] memory=10GB) then `wsl --shutdown`, or the
# model gets evicted mid-job and minutes turn into hours.
# -----------------------------------------------------------------------------

# Ollama behaviour
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_CTX=8192
# 0 = let Ollama decide (correct on GPU). On CPU set it to the physical core count.
OLLAMA_NUM_THREAD=0
# Hard cap on generated tokens per extraction; a one-page PI runs ~800-1500.
OLLAMA_NUM_PREDICT=2048
# Flash attention + q8 KV cache ~halve KV memory (important on 2-4 GB cards)
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# AMD only: override for unsupported Radeon models (e.g. 10.3.0 for RX 6000)
HSA_OVERRIDE_GFX_VERSION=

# App timeouts (on GPU you can lower OLLAMA_IDLE_TIMEOUT to 2m)
OLLAMA_IDLE_TIMEOUT=10m
OLLAMA_REQUEST_TIMEOUT=30m

# NVIDIA GPU count for gpu mode (all, or a number like 1)
GPU_COUNT=all

# Image preprocessing (lower dimension = fewer vision tokens = faster + less VRAM)
OCR_RENDER_DPI=200
OCR_MAX_IMAGE_DIMENSION=1536
# Pages of one document sent to the model in a single request. Every page costs
# ~1.5k-2.5k vision tokens, so this x per-page cost must stay under OLLAMA_NUM_CTX.
OCR_MAX_PAGES=3

# Upload limit
MAX_FILE_SIZE=50MB

# Callback OAuth (client-credentials) - REQUIRED for callback delivery.
# NOTE: callback DESTINATIONS are per-job (each API request carries its own
# callbackUrl); only the token endpoint is configured here.
CALLBACK_AUTH_TOKEN_URL=
CALLBACK_AUTH_CLIENT_ID=
CALLBACK_AUTH_CLIENT_SECRET=
CALLBACK_AUTH_SCOPE=

# JVM
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
